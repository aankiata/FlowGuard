{
 "name": "flowguard",
 "version": "0.1.0",
 "type": "module",
 "private": true,
 "scripts": {
  "test": "vitest run",
  "typecheck": "tsc",
  "baseline": "tsx src/cli.ts baseline",
  "flowguard": "tsx src/cli.ts flowguard",
  "experiment": "tsx src/cli.ts experiment",
  "ci": "tsx src/cli.ts ci",
  "robustness": "tsx src/cli.ts robustness",
  "http-check": "tsx src/cli.ts http-check",
  "report": "tsx src/cli.ts report",
  "dev": "vite",
  "build": "npm run report && vite build",
  "verify": "npm run typecheck && npm test && npm run experiment && npm run robustness && npm run http-check",
   "build:single": "npm run report && vite build --mode embed && node scripts/inline.mjs"
 },
 "devDependencies": {
  "@testing-library/react": "^16.3.3",
  "@types/node": "^26.6.5",
  "@types/react": "^19.3.0",
  "@types/react-dom": "^19.3.0",
  "@vitejs/plugin-react": "^6.1.2",
  "jsdom": "^30.1.2",
  "react": "^19.3.0",
  "react-dom": "^19.3.0",
  "tsx": "^4.23.15",
  "typescript": "^7.0.2",
  "vite": "^8.3.4",
  "vitest": "^5.0.3"
 }
}
